# Inkloom AI - Environment Configuration
PROJECT_NAME="Inkloom AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Secrets
SECRET_KEY=""
# Optional one-time administrator bootstrap (configure both values together):
# BOOTSTRAP_ADMIN_EMAIL
# BOOTSTRAP_ADMIN_PASSWORD
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Relational Database (SQLite for local dev, PostgreSQL for production)
# Use a persistent managed PostgreSQL URL for cloud deployments.
DATABASE_URL="sqlite:///./inkloom.db"

# AI Analysis Engine Configuration
# Supported: "local_deterministic" (default, 0 API key required) or "openai"
AI_PROVIDER="local_deterministic"

# Optional External AI Provider Settings
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Groq AI Model Settings (LangChain Chatbot)
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"

# Upload and Storage
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=15
